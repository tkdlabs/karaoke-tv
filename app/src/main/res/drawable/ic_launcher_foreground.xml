        android:fillColor="#FFFFFF"
        android:pathData="M45,31 L45,49 Q45,58 54,58 Q63,58 63,49 L63,31 Q63,22 54,22 Q45,22 45,31 Z" />

    <!-- Stand arc (open semicircle curving down) -->
